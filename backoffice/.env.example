# ============================================================
#  Téranga — Backoffice  |  Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

NODE_ENV=development
PORT=3001

# Base de données (même DB que le frontoffice)
DATABASE_URL="postgresql://teranga:password@localhost:5432/teranga?schema=public"

# JWT (même secret que le frontoffice pour valider les tokens)
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRES_IN=8h

# Secret admin (pour la première connexion)
ADMIN_SECRET=admin-secret-change-me

# CORS (origines autorisées)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
