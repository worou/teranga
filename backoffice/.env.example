# ============================================================
#  Téranga — Backoffice  |  Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

NODE_ENV=development
PORT=3001

# Base de données — MÊME base MySQL que le frontoffice (source de vérité).
DATABASE_URL=mysql://root@localhost:3306/teranga

# JWT du frontoffice (non utilisé pour l'auth admin, conservé par cohérence).
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRES_IN=8h

# Secret DÉDIÉ aux tokens admin (domaine de confiance séparé du frontoffice).
# Doit être fort et distinct de JWT_SECRET.
ADMIN_SECRET=admin-secret-change-me-use-strong-random

# Seed du compte admin initial (script prisma/seedAdmin.ts).
# Laisser ADMIN_SEED_PASSWORD vide pour générer un mot de passe fort affiché une fois.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# Frontoffice — cible des actions admin internes (validation de virement).
# Le backoffice relaie l'action au frontoffice (logique canonique d'abonnement).
FRONTOFFICE_API_URL=http://localhost:3000
# Secret partagé avec le frontoffice (valeur IDENTIQUE des deux côtés).
INTERNAL_API_SECRET=change-me-shared-internal-secret

# CORS (origines autorisées)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Système d'abonnement — DOIT valoir la même chose que le SUBSCRIPTIONS_ENABLED
# du frontoffice. À false (version 1), la console masque les onglets Abonnements
# et Paiements ainsi que les indicateurs de revenus. Les routes de l'API restent
# servies : l'historique garde sa valeur et un virement en attente reste
# régularisable.
SUBSCRIPTIONS_ENABLED=false
