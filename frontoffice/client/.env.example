# ============================================================
#  Téranga — Client React (Vite)
#  Copier en .env si vous devez changer une valeur.
# ============================================================

# Doit refléter SUBSCRIPTIONS_ENABLED du serveur. Nécessaire séparément parce
# que la page d'accueil publique est rendue avant toute authentification et ne
# peut donc pas lire le drapeau via l'API. Sur les écrans connectés, c'est la
# réponse de GET /users/me qui fait foi.
# Version 1 : false — le tunnel d'abonnement et la grille tarifaire sont masqués.
VITE_SUBSCRIPTIONS_ENABLED=false
