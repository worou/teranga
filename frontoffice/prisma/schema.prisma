// Téranga — Schéma de base de données
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
  // Le moteur de requête est un binaire lié à la version d'OpenSSL du système.
  // En hébergement mutualisé, le shell SSH et le serveur d'applications ne
  // tournent pas forcément dans le même environnement : ici, `prisma generate`
  // détectait debian-openssl-1.1.x alors que Passenger exécute l'application
  // en debian-openssl-1.0.x — le moteur restait introuvable au démarrage.
  // Déclarer les deux cibles fait générer les deux binaires.
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum BodyType {
  MINCE
  MOYENNE
  RONDE
}

/// Origine ethnique — donnée sensible (RGPD art. 9). Toujours facultative,
/// jamais déduite : c'est le membre qui la déclare, ou pas.
enum Ethnicity {
  AFRICAN
  ARAB
  ASIAN
  EUROPEAN
  LATIN
  NORTH_AMERICAN
  UNDISCLOSED
}

/// Publication des photos, choisie par le membre pour TOUT son profil.
///
/// Une personne qui cherche à se marier n'a pas forcément envie que ses
/// collègues, ses voisins ou sa belle-famille tombent sur son visage. Le
/// besoin est réel sur ce marché, et il ne doit pas obliger à renoncer au
/// service.
///
/// La photo reste demandée à l'inscription : elle sert d'abord à prouver
/// qu'il y a une personne réelle derrière le compte, et la modération la voit
/// toujours. Ce que ce champ règle, c'est autre chose — ce que les AUTRES
/// MEMBRES voient. Les deux fonctions étaient soudées ; elles ne le sont plus.
///
/// Il n'y a délibérément pas de valeur « floutée ». Un flou posé en CSS n'est
/// pas de la confidentialité : le fichier d'origine part quand même sur le
/// réseau et s'ouvre en deux clics. Un vrai flou demanderait de fabriquer une
/// image dérivée côté serveur, donc un processeur d'images — il n'y en a
/// aucun dans les dépendances, et ffmpeg n'est pas installé sur l'hébergement.
/// Mieux vaut deux états honnêtes qu'un troisième qui ment.
enum PhotosVisibility {
  PUBLIC
  PRIVATE
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  UNDISCLOSED
}

enum Intent {
  SERIOUS_RELATIONSHIP
  MARRIAGE
  FAMILY
}

enum Religion {
  CHRISTIAN
  MUSLIM
  OTHER
  UNDISCLOSED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  /// Mise en pause décidée par le MEMBRE lui-même, et réversible par lui.
  ///
  /// Distinct de `SUSPENDED`, qui est une sanction d'administrateur. Les
  /// confondre laisserait un membre sanctionné lever sa propre sanction en
  /// cliquant « réactiver » — le même défaut que la promotion de statut sans
  /// condition, corrigée dans `verifyOtp`.
  DEACTIVATED
  SUSPENDED
  BANNED
  DELETED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum SubscriptionPlan {
  FREE
  DISCOVERY
  STANDARD
  ENGAGEMENT
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  // Portefeuilles mobile money de la zone UEMOA / F CFA (XOF) uniquement.
  ORANGE_MONEY      // SN, CI, ML, BF, NE, GW
  WAVE              // SN, CI, ML, BF, TG, GW
  MTN_MOMO          // CI, BJ
  MOOV_MONEY        // CI, ML, BF, BJ, TG, NE
  FREE_MONEY        // SN (Free/Yas Sénégal)
  WIZALL            // SN, CI
  CARD              // Carte bancaire (partout)
  CARRIER_BILLING   // Facturation opérateur
  PAYPAL            // PayPal (redirection, facturé en EUR) — diaspora / international
  BANK_TRANSFER     // Virement bancaire (SEPA/EUR) — validation manuelle admin
}

enum MatchStatus {
  PENDING
  MATCHED
  UNMATCHED
}

enum ReportReason {
  HARASSMENT
  FAKE_PROFILE
  SCAM
  INAPPROPRIATE_CONTENT
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum EventType {
  VIRTUAL
  IN_PERSON
}

// ========== MODELS ==========

model User {
  id                String    @id @default(uuid())
  phone             String    @unique
  email             String?   @unique
  passwordHash      String?
  firstName         String
  lastName          String?
  birthDate         DateTime
  gender            Gender
  intent            Intent
  religion          Religion  @default(UNDISCLOSED)
  city              String
  country           String    // ISO code: SN, CI, ML, CM...
  profession        String?
  bio               String?   @db.Text
  hasChildren       Boolean   @default(false)
  /// Souhait d'enfants. Nullable — `null` = non renseigné, contrairement à
  /// `hasChildren` qui, non nullable et par défaut false, ne sait pas
  /// distinguer « non » de « pas répondu ».
  wantsChildren     Boolean?
  heightCm          Int?
  weightKg          Int?
  bodyType          BodyType?
  ethnicity         Ethnicity?
  /// Langues parlées, codes ISO encadrés de virgules : ",FR,WO,".
  /// MySQL ne supporte pas les tableaux Prisma ; les sentinelles rendent la
  /// recherche exacte (`contains: ',FR,'` ne peut pas matcher ",FRA,").
  languages         String?
  educationLevel    String?

  status            UserStatus         @default(PENDING_VERIFICATION)
  verificationStatus VerificationStatus @default(PENDING)
  isVerified        Boolean   @default(false)
  emailVerified     Boolean   @default(false)
  phoneVerified     Boolean   @default(false)
  biometricVerified Boolean   @default(false)

  /// Voir l'enum : ce que les autres membres voient, pas ce que la
  /// modération voit. `PUBLIC` par défaut — la discrétion s'offre à qui la
  /// demande, elle ne s'impose pas à ceux que ça n'intéresse pas.
  photosVisibility  PhotosVisibility @default(PUBLIC)

  lastActiveAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  photos            Photo[]
  subscription      Subscription?
  sentLikes         Like[]              @relation("LikesSent")
  receivedLikes     Like[]              @relation("LikesReceived")
  sentPasses        Pass[]              @relation("PassesSent")
  receivedPasses    Pass[]              @relation("PassesReceived")
  matchesAsUserA    Match[]             @relation("MatchUserA")
  matchesAsUserB    Match[]             @relation("MatchUserB")
  sentMessages      Message[]
  payments          Payment[]
  sentReports       Report[]            @relation("ReportsSent")
  receivedReports   Report[]            @relation("ReportsReceived")
  blockedUsers      Block[]             @relation("BlocksMade")
  blockedByUsers    Block[]             @relation("BlocksReceived")
  otpCodes          OtpCode[]
  refreshTokens     RefreshToken[]
  events            EventParticipant[]
  trustedCircleAsOwner TrustedCircle[]  @relation("CircleOwner")
  trustedCircleAsTrustee TrustedCircle[] @relation("CircleTrustee")
  notifications     Notification[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([country, city])
  @@index([gender, intent])
}

model Photo {
  id           String   @id @default(uuid())
  userId       String
  url          String
  order        Int      @default(0)
  isMain       Boolean  @default(false)
  moderationStatus VerificationStatus @default(PENDING)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String?
  phone     String
  code      String
  purpose   String   // "registration", "login", "password_reset"
  /// Canal d'acheminement ("email" ou "sms"). Null pour les codes emis avant
  /// l'ajout du canal e-mail : ils venaient forcement du SMS.
  channel   String?
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, code])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Subscription {
  id           String             @id @default(uuid())
  userId       String             @unique
  plan         SubscriptionPlan   @default(FREE)
  status       SubscriptionStatus @default(PENDING)
  startsAt     DateTime?
  expiresAt    DateTime?
  cancelledAt  DateTime?
  autoRenew    Boolean            @default(true)
  lastReminderAt DateTime?        // dernier rappel d'expiration/renouvellement envoyé
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([userId])
  @@index([status, expiresAt])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  subscriptionId    String?
  plan              SubscriptionPlan
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountFcfa        Int           // montant en F CFA
  currency          String        @default("XOF")
  autoRenew         Boolean       @default(true) // choix utilisateur : renouveler à l'expiration
  phoneNumber       String?       // numéro Mobile Money utilisé
  providerTxId      String?       // identifiant de transaction du provider
  providerRef       String?       @unique // référence publique du provider (idempotence webhook)
  cinetpayTxId      String?
  webhookReceived   Boolean       @default(false)
  webhookPayload    Json?
  failureReason     String?
  createdAt         DateTime      @default(now())
  completedAt       DateTime?
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([providerTxId])
}

model Like {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  isSuperLike Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("LikesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("LikesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@index([senderId])
}

/// ⚠️ Ce modèle porte une **conversation**, plus un match.
///
/// Le système de match a été retiré : tout membre au profil complet peut
/// écrire à tout membre actif, et la ligne naît du premier message envoyé —
/// non plus d'un like réciproque. Le nom du modèle et des colonnes est
/// conservé pour éviter une migration à deux dépôts (le backoffice duplique ce
/// schéma sur la même base). L'API, elle, ne parle plus que de conversations.
///
/// Conséquences à connaître :
///   - `status` n'est jamais mis à UNMATCHED : rompre un match n'existe plus ;
///   - `matchedAt` est la date d'ouverture de la conversation ;
///   - `unmatchedAt` / `unmatchedBy` ne sont plus jamais renseignés.
/// Profil écarté du fil par un membre — le « Passer » de la découverte.
///
/// Table à part, et pas un drapeau sur `Like` : ce sont deux gestes de nature
/// opposée. Un like est un signal positif, que son auteur revoit sur la carte ;
/// un pass est un refus privé, que personne n'affiche et qui ne sert qu'à ne
/// plus proposer la personne. Les mêler obligerait chaque lecture de `Like` à
/// se demander de quel geste elle parle.
model Pass {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender     User     @relation("PassesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("PassesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  /// Passer deux fois la même personne ne crée pas deux lignes : le geste est
  /// idempotent, comme le like.
  @@unique([senderId, receiverId])
  @@index([senderId])
}

model Match {
  id          String      @id @default(uuid())
  userAId     String      // always the one with the smaller UUID string
  userBId     String
  status      MatchStatus @default(MATCHED)
  matchedAt   DateTime    @default(now())
  unmatchedAt DateTime?
  unmatchedBy String?

  userA       User        @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User        @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id              String   @id @default(uuid())
  matchId         String
  senderId        String
  content         String   @db.Text
  flaggedByAi     Boolean  @default(false)
  flagReason      String?
  blockedByAi     Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())

  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Index composites : l'ordre des colonnes est ce qui compte.
  //
  // Charger un fil, c'est « les messages de CE match, les plus récents
  // d'abord ». Avec un index sur `matchId` seul et un autre sur `createdAt`
  // seul, MySQL ne peut satisfaire les deux à la fois : il choisissait
  // `createdAt` pour éviter le tri et BALAYAIT l'index entier — tous les
  // messages de tous les utilisateurs — en filtrant `matchId` au passage
  // (EXPLAIN : type=index). Le coût d'ouverture d'une conversation croissait
  // donc avec le volume total de la messagerie, pas avec sa propre taille.
  //
  // `[matchId, createdAt]` répond aux deux : égalité sur le préfixe, tri déjà
  // fait par le suffixe.
  @@index([matchId, createdAt])
  // Non-lus et marquage comme lu : « ce match, pas encore lus ». `senderId`
  // n'entre pas dans l'index — la condition porte dessus par INÉGALITÉ
  // (`senderId <> moi`), qui ne peut servir de préfixe.
  @@index([matchId, readAt])
  @@index([senderId])
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reportedId  String
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewedBy  String?
  resolution  String?
  createdAt   DateTime     @default(now())

  reporter    User         @relation("ReportsSent", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@index([status])
}

model Block {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  reason     String?
  createdAt  DateTime @default(now())

  blocker    User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Event {
  id             String              @id @default(uuid())
  title          String
  description    String              @db.Text
  type           EventType
  city           String?
  country        String?
  venueAddress   String?
  virtualLink    String?
  startsAt       DateTime
  endsAt         DateTime
  maxParticipants Int?
  coverImageUrl  String?
  createdAt      DateTime            @default(now())

  participants   EventParticipant[]

  @@index([startsAt])
  @@index([country, city])
}

model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  joinedAt  DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model TrustedCircle {
  id         String   @id @default(uuid())
  ownerId    String   // celui qui a donné accès
  trusteeId  String?  // membre Téranga qui a été invité (optionnel)
  trusteeContact String? // si ce n'est pas un utilisateur Téranga
  relation   String   // "mère", "frère", "ami(e)", etc.
  canReview  Boolean  @default(true)
  createdAt  DateTime @default(now())

  owner      User     @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  trustee    User?    @relation("CircleTrustee", fields: [trusteeId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String   // "new_match", "new_message", "subscription_expires", "event_invitation"...
  title      String
  body       String   @db.Text
  data       Json?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ========== ADMINISTRATION (backoffice) ==========
// Comptes du back-office (distincts des utilisateurs). Le frontoffice reste
// l'unique propriétaire des migrations : ce modèle vit ici pour qu'un
// `prisma db push` ne supprime jamais la table admin.
/// Réglages d'exploitation, partagés par les deux applications via la base.
///
/// Le backoffice écrit, le frontoffice lit : c'est le seul canal qu'ils ont
/// en commun. Un fichier sur disque ne conviendrait pas — ce sont deux
/// applications Passenger distinctes, avec chacune sa racine — et une variable
/// d'environnement exigerait un redémarrage, ce qui ôte tout intérêt à un
/// interrupteur.
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("ADMIN") // ADMIN | SUPERADMIN
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}
