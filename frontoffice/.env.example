# ============================================================
#  Téranga — Frontoffice  |  Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Base de données
DATABASE_URL="postgresql://teranga:password@localhost:5432/teranga?schema=public"
DB_PASSWORD=password

# JWT
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Complétude du profil exigée pour finaliser l'inscription. Sous PROFILE_MIN_PHOTOS
# photos, la découverte, les matchs et la messagerie répondent 403 PHOTOS_REQUIRED
# (l'envoi de photos, lui, reste ouvert : c'est ce qui lève le blocage).
PROFILE_MIN_PHOTOS=3
PROFILE_MAX_PHOTOS=6

# Système d'abonnement (modèle freemium : messagerie payante pour les hommes).
# VERSION 1 = désactivé : accès complet et gratuit pour tout le monde, tunnel de
# paiement retiré du routage (404) et planificateur d'expiration à l'arrêt. Le
# code de paiement reste en place et testé. Passer à `true` réactive le tout —
# penser à mettre VITE_SUBSCRIPTIONS_ENABLED=true côté client (client/.env).
SUBSCRIPTIONS_ENABLED=false

# CinetPay (paiements Mobile Money)
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_SECRET_KEY=your-cinetpay-secret-key
CINETPAY_NOTIFY_URL=http://localhost:3000/api/v1/payments/webhook/cinetpay
CINETPAY_RETURN_URL=http://localhost:3000/api/v1/payments/return

# PayPal (Paiements Standard — redirection + IPN). Facturation en EUR (parité
# fixe CFA). En dev (PAYPAL_ENV != live), le paiement est simulé localement.
PAYPAL_EMAIL=your-paypal-merchant-email@example.com
# 'sandbox' (test) ou 'live' (production réelle).
PAYPAL_ENV=sandbox
# Retour utilisateur après paiement (écran d'abonnement côté client).
PAYPAL_RETURN_URL=http://localhost:5173/abonnement?paypal=done
PAYPAL_CANCEL_URL=http://localhost:5173/abonnement?paypal=cancel

# Virement bancaire (SEPA / EUR) — validation manuelle par un admin.
# Le moyen « Virement bancaire » n'est proposé que si BANK_TRANSFER_IBAN est
# renseigné. Données bancaires réelles = à mettre ICI (jamais dans le code/git).
BANK_TRANSFER_BENEFICIARY=NOM DU TITULAIRE
BANK_TRANSFER_IBAN=FR76XXXXXXXXXXXXXXXXXXXXXXX
BANK_TRANSFER_BIC=XXXXXXXXXXX
BANK_TRANSFER_BANK=Nom de la banque

# Secret partagé backoffice → frontoffice pour les actions admin internes
# (validation d'un virement). DOIT être défini (identique côté backoffice) en
# production ; sinon le frontoffice refuse ces appels (fail-closed).
INTERNAL_API_SECRET=change-me-shared-internal-secret

# Twilio (OTP par SMS — fournisseur par défaut)
# Sans ces valeurs, aucun SMS n'est envoyé : le code OTP est journalisé
# (niveau warn) pour permettre les tests locaux. Renseignez-les pour l'envoi réel.
#   - ATTENTION compte d'essai (trial) : Twilio n'envoie qu'aux numéros VÉRIFIÉS
#     et ajoute un préfixe « Sent from your Twilio trial account ». Vérifiez le
#     numéro destinataire (Console > Phone Numbers > Verified Caller IDs) ou
#     passez le compte en payant avant de tester un vrai numéro (+229…).
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Émetteur : renseignez UN des deux.
#   - TWILIO_FROM : numéro Twilio SMS au format E.164 (ex. +12025550123).
#   - TWILIO_MESSAGING_SERVICE_SID : Messaging Service (RECOMMANDÉ pour
#     l'Afrique de l'Ouest — Sender ID alphanumérique + routage par pays).
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Orange SMS (OTP) — fournisseur historique, désormais OPTIONNEL.
# Conservé pour compatibilité ; l'envoi OTP passe par Twilio ci-dessus.
ORANGE_SMS_CLIENT_ID=your-orange-client-id
ORANGE_SMS_CLIENT_SECRET=your-orange-client-secret
# Numéro émetteur provisionné chez Orange (E.164). OBLIGATOIRE pour l'envoi réel.
ORANGE_SMS_SENDER_NUMBER=+221771234567
# Nom d'expéditeur alphanumérique optionnel (≤ 11 car., à faire whitelister par Orange).
ORANGE_SMS_SENDER=Teranga

# Smile Identity (vérification biométrique)
SMILE_PARTNER_ID=your-smile-partner-id
SMILE_API_KEY=your-smile-api-key

# Stockage S3 (Scaleway / AWS)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=teranga-media
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Modération images (SightEngine)
SIGHTENGINE_API_USER=your-sightengine-user
SIGHTENGINE_API_SECRET=your-sightengine-secret

# CORS (origines autorisées)
CORS_ORIGIN=http://localhost:3001,https://teranga.africa

# Nombre de reverse proxys de confiance devant l'application.
# 0 = aucun (défaut). À passer à 1 en production derrière nginx, un load
# balancer ou une plateforme type Heroku/Render : sans cela, la limitation de
# débit voit l'adresse du proxy et compte TOUS les utilisateurs dans un seul
# seau. Ne pas le mettre à 1 sans proxy devant : X-Forwarded-For serait alors
# forgeable et la limitation contournable.
TRUST_PROXY=0

# Limitation de débit globale sur /api/v1.
# 300 / 15 min = 20 req/min. Ne pas descendre sous ~150 : le fil de
# conversation s'actualise toutes les 8 s, soit 7,5 req/min à lui seul.
# Les routes d'authentification gardent un plafond strict et séparé (20/15 min).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Nombre de conversations qu'un membre peut OUVRIR par jour — frein anti-spam,
# la messagerie étant ouverte à tous depuis la suppression du système de match.
# Répondre dans une conversation en cours n'est jamais compté.
MESSAGING_DAILY_NEW_CONVERSATIONS=30
