# ============================================================
#  Téranga — Frontoffice  |  Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Base de données
DATABASE_URL="postgresql://teranga:password@localhost:5432/teranga?schema=public"
DB_PASSWORD=password

# JWT
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CinetPay (paiements Mobile Money)
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_SECRET_KEY=your-cinetpay-secret-key
CINETPAY_NOTIFY_URL=http://localhost:3000/api/v1/payments/webhook/cinetpay
CINETPAY_RETURN_URL=http://localhost:3000/api/v1/payments/return

# Orange SMS (OTP)
ORANGE_SMS_CLIENT_ID=your-orange-client-id
ORANGE_SMS_CLIENT_SECRET=your-orange-client-secret
ORANGE_SMS_SENDER=Teranga

# Smile Identity (vérification biométrique)
SMILE_PARTNER_ID=your-smile-partner-id
SMILE_API_KEY=your-smile-api-key

# Stockage S3 (Scaleway / AWS)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=teranga-media
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Modération images (SightEngine)
SIGHTENGINE_API_USER=your-sightengine-user
SIGHTENGINE_API_SECRET=your-sightengine-secret

# CORS (origines autorisées)
CORS_ORIGIN=http://localhost:3001,https://teranga.africa

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
