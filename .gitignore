node_modules/
dist/
.env
.env.local
# Tout dérivé de .env — sauvegardes, variantes d'environnement, copies de
# travail. Une seule de ces copies commitée suffit à publier les secrets.
# `!.env.example` remet l'exception : ce fichier-là doit rester versionné.
.env.*
!.env.example
*.log
.DS_Store
coverage/
*.zip
.claude/

# Photos de membres deposees en local (dev). Le dossier est versionne, son
# contenu non : ce sont des donnees personnelles, pas du code.
frontoffice/uploads/*
!frontoffice/uploads/.gitkeep
